# Copy these values into Vercel → Project → Settings → Environment Variables.
# Do not commit your real .env file. These values must never be in browser JavaScript.
ADMIN_EMAIL=your-admin-email@gmail.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_SESSION_SECRET=generate-a-random-secret-of-at-least-32-bytes
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
